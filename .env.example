# From @BotFather
BOT_TOKEN=
BOT_USERNAME=YourBotName

# From Google Cloud Console → APIs & Services → Credentials (OAuth client, type "Web application")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public HTTPS URL where this server runs (used for OAuth redirect + legal pages)
BASE_URL=https://your-domain.com
PORT=3000

APP_NAME=TeleCal
CONTACT_EMAIL=support@your-domain.com
DEFAULT_TZ=UTC

# Optional: point the bot's legal links at the GitHub Pages copies
PRIVACY_URL=https://pwintsan4238.github.io/telecal/privacy.html
TERMS_URL=https://pwintsan4238.github.io/telecal/terms.html
